function addRoles() {
  var st = getSettings_();
  var existing = readRows_(CFG.SHEET.APPS).concat(readRows_(CFG.SHEET.DISC)).map(function (r) {
    return { company: r['Company'], role: r['Role'], link: r['Link'], location: r['Location'] };
  });
  var sorted = NEW_ROLES.slice().sort(function (a, b) {
    var da = toDate(a.deadline), db = toDate(b.deadline);
    if (da && db) return da - db;
    if (da) return -1;
    if (db) return 1;
    return (b.fit || 0) - (a.fit || 0);
  });
  var added = 0, skipped = 0;
  sorted.forEach(function (j) {
    if (addRolesIsDup_(j, existing)) { skipped++; return; }
    var o = {
      'Company': j.company, 'Role': j.role, 'Type': j.type, 'Category': j.category,
      'Location': j.location, 'Remote?': j.remote || 'Unknown', 'Pay (as listed)': j.pay || 'Not listed',
      'Fit score': j.fit, 'Link': j.link, 'Source': 'Discovered',
      'Deadline': toDate(j.deadline) || 'Rolling', 'Status': 'To apply',
      'Furthest stage reached': 'To apply', 'Resume version': j.resume,
      'Next action': 'Verify posting is open, then apply', 'Last update': new Date(),
      'Notes': 'Why: ' + j.why + (j.notes ? '\n' + j.notes : '') +
        '\n[Found by Claude 2026-10-28 from search results — open the link to confirm before applying.]',
      'Needs review': false, 'Row ID': newRowId_()
    };
    enrichPay_(o, st);
    appendRow_(CFG.SHEET.APPS, o);
    existing.push({ company: j.company, role: j.role, link: j.link, location: j.location });
    logHistory_(o['Row ID'], j.company, j.role, '', 'To apply', 'Claude research');
    added++;
  });
  SpreadsheetApp.getActiveSpreadsheet().toast('Added ' + added + ' roles (' + skipped + ' duplicates skipped).', 'Job Tracker', 10);
  Logger.log('Added ' + added + ', skipped ' + skipped);
}

function addRolesIsDup_(job, existing) {
  var k = dedupeKey(job.company, job.role), u = normalizeUrl(job.link);
  var loc = String(job.location || '').toLowerCase().slice(0, 12);
  // a link with a job ID (5+ digits) is one specific posting
  if (u && /\d{5,}/.test(u) && existing.some(function (e) { return normalizeUrl(e.link) === u; })) return true;
  return existing.some(function (e) {
    var eloc = String(e.location || '').toLowerCase().slice(0, 12);
    if (loc && eloc && loc !== eloc) return false;
    if (dedupeKey(e.company, e.role) === k) return true;
    if (companySim(e.company, job.company) < 0.85) return false;
    var r1 = roleSim(e.role, job.role), r2 = roleSim(job.role, e.role);
    if (u && normalizeUrl(e.link) === u && r1 >= 0.5 && r2 >= 0.5) return true;
    return r1 >= 0.9 && r2 >= 0.9;
  });
}

